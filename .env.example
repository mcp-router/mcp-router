# MCP Router Environment Variables
# Copy this file to .env and fill in the values you need.

# ── Build / Packaging ─────────────────────────────────────────────
# macOS code-signing identity (Apple Developer ID)
# PUBLIC_IDENTIFIER=

# Apple notarization credentials
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=

# GitHub personal access token (used by electron-forge publisher-github)
# GITHUB_TOKEN=

# ── Development ───────────────────────────────────────────────────
# Webpack dev server (renderer process)
# WEBPACK_DEV_SERVER_PORT=9000
# WEBPACK_DEV_SERVER_HOST=127.0.0.1

# Override detected environment (development | production)
# NODE_ENV=development
# ELECTRON_ENV=development

# ── CLI ───────────────────────────────────────────────────────────
# Authentication token for MCP Router CLI (mcpr connect)
# MCPR_TOKEN=
