{
  "name": "mcp-router",
  "version": "0.4.9",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-router/mcp-router"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:electron": "turbo run dev --filter=@mcp-router/electron --filter=@mcp-router/shared",
    "build": "turbo run build",
    "start": "pnpm --filter @mcp-router/electron start",
    "package": "pnpm --filter @mcp-router/electron package",
    "make": "pnpm --filter @mcp-router/electron make",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "keywords": [],
  "author": {
    "name": "fjm2u",
    "email": "fm.job@icloud.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "turbo": "^2.3.3",
    "concurrently": "^9.1.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.3",
    "eslint-plugin-import": "^2.31.0",
    "typescript": "^5.8.3"
  }
}
